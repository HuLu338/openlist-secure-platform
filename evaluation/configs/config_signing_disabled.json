{
  "scheme": {
    "https": true,
    "skip_tls_verify": false
  },
  "deployment": {
    "public": true
  },
  "security": {
    "jwt_secret": "safe-openlist-secret-value",
    "token_expire_hours": 24,
    "sign_all": false
  },
  "log": {
    "enable": true
  },
  "services": {
    "ftp_enable": false,
    "sftp_enable": false
  }
}
